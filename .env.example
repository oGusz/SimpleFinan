# Copie para .env.local e preencha. Nunca versione os valores reais.
# As variáveis sem NEXT_PUBLIC_ são segredos do servidor: cadastre-as só no ambiente da Vercel.

# Obrigatórias
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BRAPI_TOKEN=
NEXT_PUBLIC_APP_URL=
CRON_SECRET=

# Open Finance
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Com "sandbox", os bancos de teste aparecem para TODOS os usuários. Em produção, use "production".
PLUGGY_ENVIRONMENT=sandbox
PLUGGY_WEBHOOK_SECRET=
# Opcional: só muda se a Pluggy indicar outro endereço de API.
PLUGGY_API_URL=

# Assinaturas
REVENUECAT_WEBHOOK_AUTH=
# Opcional: sem ela, a exclusão de conta não apaga o cliente na RevenueCat e só registra um aviso.
REVENUECAT_SECRET_KEY=
# UUIDs do Supabase, separados por vírgula, cujas compras de teste liberam o Premium (contas de revisão).
REVENUECAT_SANDBOX_USER_IDS=
# "true" libera a compra de teste de qualquer conta (TestFlight, revisor que criou outra conta).
REVENUECAT_ALLOW_SANDBOX=false

# E-mails (ficam desligados sem estas duas)
RESEND_API_KEY=
EMAIL_FROM=

# Lembretes por notificação no celular. Só use "true" depois de aplicar migration_commercial.sql.
PUSH_REMINDERS_ENABLED=false

# Opcional: protege os hashes de IP e e-mail do limite de tentativas. Trocar só zera os contadores.
RATE_LIMIT_SECRET=

# Métricas e erros (opcionais)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
# Opcional: stack traces legíveis no Sentry.
SENTRY_AUTH_TOKEN=
# Opcionais: sem as duas, a exclusão de conta não apaga a pessoa no PostHog e só registra um aviso.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Dados legais exibidos em /termos, /privacidade, /sobre, /suporte e /excluir-conta.
# Sem eles, as páginas mostram "(a preencher antes da publicação)" e scripts/check-release.mjs bloqueia o envio.
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_DOCUMENT_ID=
NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=
NEXT_PUBLIC_LEGAL_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_CITY=
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=

# Links das lojas em /sobre e /planos. Preencha depois que as fichas estiverem publicadas.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Ative somente depois de configurar o provedor Apple no Supabase.
# Desligada, o iOS mostra só e-mail e senha, sem Google e Facebook (regra 4.8 da App Store).
NEXT_PUBLIC_APPLE_LOGIN_ENABLED=false

# App Expo (mobile/): estas ficam no ambiente production do EAS, não na Vercel.
# EXPO_PUBLIC_WEB_URL também é lida por scripts/check-release.mjs.
EXPO_PUBLIC_WEB_URL=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
